# Automatically activate Poetry virtual environment
if command -v poetry >/dev/null 2>&1; then
    # Ensure Poetry creates venv in project directory
    poetry config virtualenvs.in-project true --local 2>/dev/null || true

    # Activate the Poetry shell environment
    if [ -d .venv ]; then
        source .venv/bin/activate
    elif [ -f pyproject.toml ]; then
        # If venv doesn't exist, create it
        poetry install --no-root 2>/dev/null || true
        [ -d .venv ] && source .venv/bin/activate
    fi
fi

# Load environment variables if .env file exists
if [ -f .env ]; then
    dotenv .env 2>/dev/null || true
fi
