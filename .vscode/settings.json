{
    // Python & Poetry
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.poetryPath": "poetry",

    // Terminal - Auto-activate Poetry environment
    "terminal.integrated.defaultLocation": "panel",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.env.osx": {
        "POETRY_VENV_IN_PROJECT": "true"
    },
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.automationProfile.osx": {
        "path": "/bin/zsh"
    },

    // Cursor AI settings
    "cursor.autopilot.enabled": true,
    "cursor.autopilot.context": "project",

    // Editor settings
    "editor.fontFamily": "'Cascadia Code', 'Fira Code', monospace",
    "editor.fontSize": 12,
    "editor.lineHeight": 1.5,

    // Extensions (Cursor has many built-in)
    "extensions.autoUpdate": true
  }
